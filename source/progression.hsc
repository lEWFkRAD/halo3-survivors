(script static void sv_s1_observe
(set sv_now (ai_living_count sv_s1_grunts))
(if (< sv_now sv_s1_grunts_prev)
    (set sv_xp (+ sv_xp (* (* (- sv_s1_grunts_prev sv_now) 10) sv_xp_scale))))
(set sv_s1_grunts_prev sv_now)
(set sv_now (ai_living_count sv_s1_jackals))
(if (< sv_now sv_s1_jackals_prev)
    (set sv_xp (+ sv_xp (* (* (- sv_s1_jackals_prev sv_now) 20) sv_xp_scale))))
(set sv_s1_jackals_prev sv_now)
(set sv_now (ai_living_count sv_s1_brutes))
(if (< sv_now sv_s1_brutes_prev)
    (set sv_xp (+ sv_xp (* (* (- sv_s1_brutes_prev sv_now) 30) sv_xp_scale))))
(set sv_s1_brutes_prev sv_now)
)
(script static void sv_s1_spawn
(set sv_total (ai_living_count sv_hostiles))
(set sv_spawn_players (players))
(if (and (>= sv_stage_seconds 90) (= (ai_living_count sv_s1_brutes) 0)
    (<= (+ sv_total 3) sv_cap))
    (begin
        (sv_s1_brutes_clear)
        (if sv_spawn_clear (begin
        (ai_erase sv_s1_brutes) (ai_place sv_s1_brutes 3)
        (ai_set_team sv_s1_brutes covenant)
        (ai_set_objective sv_s1_brutes sv_hunt_1)
        (ai_magically_see_object sv_s1_brutes (sv_player))
        (set sv_s1_brutes_prev (ai_living_count sv_s1_brutes))
        (set sv_total (+ sv_total sv_s1_brutes_prev))))))
(if (and (>= sv_stage_seconds 30) (= (ai_living_count sv_s1_jackals) 0)
    (<= (+ sv_total 4) sv_cap))
    (begin
        (sv_s1_jackals_clear)
        (if sv_spawn_clear (begin
        (ai_erase sv_s1_jackals) (ai_place sv_s1_jackals 4)
        (ai_set_team sv_s1_jackals covenant)
        (ai_set_objective sv_s1_jackals sv_hunt_1)
        (ai_magically_see_object sv_s1_jackals (sv_player))
        (set sv_s1_jackals_prev (ai_living_count sv_s1_jackals))
        (set sv_total (+ sv_total sv_s1_jackals_prev))))))
(if (and (>= sv_stage_seconds 0) (= (ai_living_count sv_s1_grunts) 0)
    (<= (+ sv_total 6) sv_cap))
    (begin
        (sv_s1_grunts_clear)
        (if sv_spawn_clear (begin
        (ai_erase sv_s1_grunts) (ai_place sv_s1_grunts 6)
        (ai_set_team sv_s1_grunts covenant)
        (ai_set_objective sv_s1_grunts sv_hunt_1)
        (ai_magically_see_object sv_s1_grunts (sv_player))
        (set sv_s1_grunts_prev (ai_living_count sv_s1_grunts))
        (set sv_total (+ sv_total sv_s1_grunts_prev))))))
)
