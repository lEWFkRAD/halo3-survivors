((and (>= sv_selection 47) (< sv_selection 50)) (set sv_selection 0)))
(sv_show_node)
)
(script static void sv_checkpoint
(if (and sv_save_dirty sv_menu_open sv_running (not sv_finished))
    (begin (set sv_save_dirty false)
        (core_save_name "laststand_v04_pending")))
)
(script static void sv_restore_controls
(set sv_restore_clock (+ sv_restore_clock 3))
(if (>= sv_restore_clock 30)
    (begin (set sv_restore_clock 0)
        (camera_control true) (player_camera_control false)
        (set sv_view_refresh true)
        (hud_enable_training sv_menu_open)
        (chud_show_weapon_stats false) (chud_show_grenades false)
        (chud_show_crosshair false) (player_disable_weapon_pickup true)
        (if sv_menu_open (ai_enable false))
        (sv_follow)))
)
(script static void sv_open_menu
(set sv_menu_open true) (set sv_menu_clock 0)
(set sv_save_dirty true)
(set sv_menu_any false) (set sv_menu_latched true)
(player_disable_movement false)
(ai_enable false)
(object_cannot_take_damage (players))
(object_cannot_take_damage (ai_actors sv_hostiles))
(sv_reset_actions)
(sv_show_node) (sv_notify_controls)
)
(script static void sv_close_menu
(set sv_menu_open false)
(hud_enable_training false)
(set sv_menu_any false) (set sv_menu_latched false)
(player_disable_movement false)
(object_can_take_damage (players))
(object_can_take_damage (ai_actors sv_hostiles))
(ai_enable true) (sv_reset_actions)
(cinematic_set_chud_objective sv_resumed) (sv_show_stage)
)
(script static void sv_menu_input
(set sv_key_resume (player_action_test_rotate_weapons))
(set sv_key_buy (player_action_test_primary_trigger))
(set sv_key_previous (player_action_test_melee))
(set sv_key_next (player_action_test_jump))
(set sv_key_category (and sv_key_next sv_key_previous))
(set sv_menu_any (or sv_key_resume sv_key_category sv_key_buy sv_key_previous sv_key_next))
(if (and sv_menu_any (not sv_menu_latched))
    (begin (set sv_menu_latched true)
        (cond
            (sv_key_resume (sv_close_menu))
            (sv_key_category (sv_menu_category))
            (sv_key_buy (sv_purchase))
            (sv_key_previous (sv_menu_previous))
            (sv_key_next (sv_menu_next)))))
(if (not sv_menu_any) (set sv_menu_latched false))
(sv_reset_actions)
(if sv_menu_open
    (begin
        (set sv_menu_clock (+ sv_menu_clock 3))
        (if (= sv_menu_clock 90) (sv_show_node))
        (if (= sv_menu_clock 180) (sv_show_node))
        (if (>= sv_menu_clock 270)
            (begin (set sv_menu_clock 0) (sv_notify_controls)))))
)
(script static void sv_reopen_test
(set sv_key_next (player_action_test_jump))
(set sv_key_previous (player_action_test_melee))
(if (and sv_key_next sv_key_previous) (sv_open_menu))
(sv_reset_actions)
)
(script static void sv_boundary_check
(if (and (= sv_stage 1) (> (objects_distance_to_flag (players) sv_s1_center) 21)) (begin (object_teleport (sv_player) sv_s1_center) (sv_notify_boundary)))
(if (and (= sv_stage 2) (> (objects_distance_to_flag (players) sv_s2_center) 21)) (begin (object_teleport (sv_player) sv_s2_center) (sv_notify_boundary)))
(if (and (= sv_stage 3) (> (objects_distance_to_flag (players) sv_s3_center) 21)) (begin (object_teleport (sv_player) sv_s3_center) (sv_notify_boundary)))
(if (and (= sv_stage 4) (> (objects_distance_to_flag (players) sv_s4_center) 21)) (begin (object_teleport (sv_player) sv_s4_center) (sv_notify_boundary)))
)
(script static void sv_enter_stage_position_0
(if (= sv_stage 1) (begin
(object_teleport (sv_player) sv_s1_center)
(camera_set sv_s1_view_0 0)
(sv_notify_stage_1)))
(if (= sv_stage 2) (begin
(object_teleport (sv_player) sv_s2_center)
(camera_set sv_s2_view_0 0)
(sv_notify_stage_2)))
(if (= sv_stage 3) (begin
(object_teleport (sv_player) sv_s3_center)
(camera_set sv_s3_view_0 0)
(sv_notify_stage_3)))
(if (= sv_stage 4) (begin
(object_teleport (sv_player) sv_s4_center)
(camera_set sv_s4_view_0 0)
(sv_notify_stage_4)))
)
