(script static void sv_menu_next
(set sv_selection (+ sv_selection 1))
(if (>= sv_selection 50) (set sv_selection 0)) (sv_show_node) (sv_show_rank)
)
(script static void sv_menu_previous
(set sv_selection (- sv_selection 1))
(if (< sv_selection 0) (set sv_selection 49)) (sv_show_node) (sv_show_rank)
)
(script static void sv_menu_category
(cond
((and (>= sv_selection 0) (< sv_selection 7)) (set sv_selection 7))
((and (>= sv_selection 7) (< sv_selection 14)) (set sv_selection 14))
((and (>= sv_selection 14) (< sv_selection 21)) (set sv_selection 21))
((and (>= sv_selection 21) (< sv_selection 28)) (set sv_selection 28))
((and (>= sv_selection 28) (< sv_selection 35)) (set sv_selection 35))
((and (>= sv_selection 35) (< sv_selection 42)) (set sv_selection 42))
