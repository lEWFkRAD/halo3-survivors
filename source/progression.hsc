(script static void sv_follow
(set sv_view_players (players))
(set sv_view_nearest 100000)
(set sv_view_current_distance -1)
(set sv_view_index -1)
(if (= sv_stage 1) (sv_s1_scan))
(if (= sv_stage 2) (sv_s2_scan))
(if (= sv_stage 3) (sv_s3_scan))
(if (= sv_stage 4) (sv_s4_scan))
(if (>= sv_view_index 0)
    (begin
        (if (or (< sv_view_current_distance 0)
                (< (+ sv_view_nearest 0.35) sv_view_current_distance))
            (begin (set sv_view_current sv_view_index) (set sv_view_refresh true)))
        (if sv_view_refresh
            (begin (set sv_view_index sv_view_current) (sv_view_apply)))))
(set sv_view_refresh false)
)
