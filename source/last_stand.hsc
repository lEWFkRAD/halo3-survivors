)
(script continuous sv_auto_clock
    (sleep 12)
    (if (and sv_running (not sv_finished) (> (unit_get_health (sv_player)) 0))
        (sv_autofire)))
(script static void sv_spawn
    (set sv_total 0)
    (set sv_total (+ sv_total (ai_living_count sv_grunts_a)))
    (set sv_total (+ sv_total (ai_living_count sv_grunts_b)))
    (set sv_total (+ sv_total (ai_living_count sv_grunts_c)))
    (set sv_total (+ sv_total (ai_living_count sv_grunts_d)))
    (set sv_total (+ sv_total (ai_living_count sv_jackals)))
    (set sv_total (+ sv_total (ai_living_count sv_brutes)))
    (set sv_total (+ sv_total (ai_living_count sv_flood)))
    (set sv_total (+ sv_total (ai_living_count sv_hunters)))
    (if (and (>= sv_seconds 900) (= (ai_living_count sv_hunters) 0)
             (<= (+ sv_total 2) sv_cap))
        (begin
            (ai_erase sv_hunters)
            (ai_place sv_hunters 2)
            (ai_set_team sv_hunters covenant)
            (ai_set_objective sv_hunters sv_hunt)
            (ai_magically_see_object sv_hunters (sv_player))
            (set sv_hunters_prev (ai_living_count sv_hunters))
            (set sv_total (+ sv_total sv_hunters_prev))))
    (if (and (>= sv_seconds 600) (= (ai_living_count sv_flood) 0)
             (<= (+ sv_total 8) sv_cap))
        (begin
            (ai_erase sv_flood)
            (ai_place sv_flood 8)
            (ai_set_team sv_flood covenant)
            (ai_set_objective sv_flood sv_hunt)
            (ai_magically_see_object sv_flood (sv_player))
            (set sv_flood_prev (ai_living_count sv_flood))
            (set sv_total (+ sv_total sv_flood_prev))))
    (if (and (>= sv_seconds 360) (= (ai_living_count sv_brutes) 0)
             (<= (+ sv_total 4) sv_cap))
        (begin
            (ai_erase sv_brutes)
            (ai_place sv_brutes 4)
            (ai_set_team sv_brutes covenant)
            (ai_set_objective sv_brutes sv_hunt)
            (ai_magically_see_object sv_brutes (sv_player))
            (set sv_brutes_prev (ai_living_count sv_brutes))
            (set sv_total (+ sv_total sv_brutes_prev))))
    (if (and (>= sv_seconds 180) (= (ai_living_count sv_jackals) 0)
             (<= (+ sv_total 4) sv_cap))
        (begin
            (ai_erase sv_jackals)
            (ai_place sv_jackals 4)
            (ai_set_team sv_jackals covenant)
            (ai_set_objective sv_jackals sv_hunt)
            (ai_magically_see_object sv_jackals (sv_player))
            (set sv_jackals_prev (ai_living_count sv_jackals))
            (set sv_total (+ sv_total sv_jackals_prev))))
    (if (and (>= sv_seconds 120) (= (ai_living_count sv_grunts_d) 0)
             (<= (+ sv_total 6) sv_cap))
        (begin
            (ai_erase sv_grunts_d)
            (ai_place sv_grunts_d 6)
            (ai_set_team sv_grunts_d covenant)
            (ai_set_objective sv_grunts_d sv_hunt)
            (ai_magically_see_object sv_grunts_d (sv_player))
            (set sv_grunts_d_prev (ai_living_count sv_grunts_d))
            (set sv_total (+ sv_total sv_grunts_d_prev))))
    (if (and (>= sv_seconds 60) (= (ai_living_count sv_grunts_c) 0)
             (<= (+ sv_total 6) sv_cap))
        (begin
            (ai_erase sv_grunts_c)
            (ai_place sv_grunts_c 6)
            (ai_set_team sv_grunts_c covenant)
            (ai_set_objective sv_grunts_c sv_hunt)
            (ai_magically_see_object sv_grunts_c (sv_player))
            (set sv_grunts_c_prev (ai_living_count sv_grunts_c))
            (set sv_total (+ sv_total sv_grunts_c_prev))))
    (if (and (>= sv_seconds 0) (= (ai_living_count sv_grunts_b) 0)
             (<= (+ sv_total 6) sv_cap))
        (begin
            (ai_erase sv_grunts_b)
            (ai_place sv_grunts_b 6)
            (ai_set_team sv_grunts_b covenant)
            (ai_set_objective sv_grunts_b sv_hunt)
            (ai_magically_see_object sv_grunts_b (sv_player))
            (set sv_grunts_b_prev (ai_living_count sv_grunts_b))
            (set sv_total (+ sv_total sv_grunts_b_prev))))
    (if (and (>= sv_seconds 0) (= (ai_living_count sv_grunts_a) 0)
             (<= (+ sv_total 6) sv_cap))
        (begin
            (ai_erase sv_grunts_a)
            (ai_place sv_grunts_a 6)
            (ai_set_team sv_grunts_a covenant)
            (ai_set_objective sv_grunts_a sv_hunt)
            (ai_magically_see_object sv_grunts_a (sv_player))
            (set sv_grunts_a_prev (ai_living_count sv_grunts_a))
            (set sv_total (+ sv_total sv_grunts_a_prev))))
 )
(script static void sv_level_up
    (if (>= sv_xp sv_threshold)
        (begin
            (set sv_xp (- sv_xp sv_threshold))
            (set sv_level (+ sv_level 1))
            (set sv_tokens (+ sv_tokens 1))
            (hud_activate_team_nav_point_flag player sv_beacon_needler 0.5)
            (hud_activate_team_nav_point_flag player sv_beacon_aegis 0.5)
            (hud_activate_team_nav_point_flag player sv_beacon_vitality 0.5)
            (set sv_threshold (+ sv_threshold 50))
            (cinematic_set_chud_objective sv_upgrade_ready))))

(script static void sv_choices
    (if (not (or (and (>= (objects_distance_to_flag (players) sv_beacon_needler) 0) (<= (objects_distance_to_flag (players) sv_beacon_needler) 1.0))
                 (and (>= (objects_distance_to_flag (players) sv_beacon_aegis) 0) (<= (objects_distance_to_flag (players) sv_beacon_aegis) 1.0))
                 (and (>= (objects_distance_to_flag (players) sv_beacon_vitality) 0) (<= (objects_distance_to_flag (players) sv_beacon_vitality) 1.0))))
        (set sv_pad_latched false))
    (if (and (> sv_tokens 0) (not sv_pad_latched))
        (cond
            ((and (>= (objects_distance_to_flag (players) sv_beacon_needler) 0) (<= (objects_distance_to_flag (players) sv_beacon_needler) 1.0))
                (begin
                    (set sv_pad_latched true)
                    (if (< sv_needler_rank 3)
                        (begin
                            (set sv_needler_rank (+ sv_needler_rank 1))
                            (set sv_tokens (- sv_tokens 1))
                            (cond
                                ((= sv_needler_rank 1) (unit_add_equipment (sv_player) sv_needler_1 true false))
                                ((= sv_needler_rank 2) (unit_add_equipment (sv_player) sv_needler_2 true false))
                                ((= sv_needler_rank 3) (unit_add_equipment (sv_player) sv_needler_3 true false)))
                            (cinematic_set_chud_objective sv_needler)))))
            ((and (>= (objects_distance_to_flag (players) sv_beacon_aegis) 0) (<= (objects_distance_to_flag (players) sv_beacon_aegis) 1.0))
                (begin
                    (set sv_pad_latched true)
                    (if (< sv_aegis_rank 5)
                        (begin
                            (set sv_aegis_rank (+ sv_aegis_rank 1))
                            (set sv_tokens (- sv_tokens 1))
                            (cinematic_set_chud_objective sv_aegis)))))
            ((and (>= (objects_distance_to_flag (players) sv_beacon_vitality) 0) (<= (objects_distance_to_flag (players) sv_beacon_vitality) 1.0))
                (begin
                    (set sv_pad_latched true)
                    (if (< sv_vitality_rank 5)
                        (begin
                            (set sv_vitality_rank (+ sv_vitality_rank 1))
                            (set sv_tokens (- sv_tokens 1))
                            (units_set_maximum_vitality (players)
                                (* 45 (+ 1 (* 0.2 sv_vitality_rank)))
                                (* 70 (+ 1 (* 0.2 sv_vitality_rank))))
                            (units_set_current_vitality (players)
                                (* 45 (+ 1 (* 0.2 sv_vitality_rank)))
                                (* 70 (+ 1 (* 0.2 sv_vitality_rank))))
                            (cinematic_set_chud_objective sv_vitality))))))))

(script static void sv_shield_pulse
    (set sv_shield_clock (+ sv_shield_clock 1))
    (if (>= sv_shield_clock 8)
        (begin
            (set sv_shield_clock 0)
            (if (> sv_aegis_rank 0)
                (object_set_shield (sv_player)
                    (min 1.0 (+ (/ (unit_get_shield (sv_player)) (* 70 (+ 1 (* 0.2 sv_vitality_rank)))) (* 0.15 sv_aegis_rank))))))))

(script static void sv_lose
    (set sv_running false)
    (set sv_finished true)
    (cinematic_set_chud_objective sv_loss)
    (game_lost true))

(script static void sv_step
    (if (and sv_running (not sv_finished))
        (if (or (!= (list_count (players)) 1) (<= (unit_get_health (sv_player)) 0))
            (sv_lose)
            (begin
                (sv_observe)
                (sv_level_up)
                (sv_choices)
                (sv_shield_pulse)
                (set sv_seconds (+ sv_seconds 1))
                (cond
                    ((= sv_seconds 360) (cinematic_set_chud_objective sv_phase2))
                    ((= sv_seconds 600) (cinematic_set_chud_objective sv_phase3))
                    ((= sv_seconds 900) (cinematic_set_chud_objective sv_phase4))
                    ((= sv_seconds 1200) (begin (cinematic_set_chud_objective sv_extract) (hud_activate_team_nav_point_flag player sv_beacon_exit 0.5))))
                (if (< sv_seconds 1200)
                    (begin
                        (set sv_spawn_clock (- sv_spawn_clock 1))
                        (if (<= sv_spawn_clock 0)
                            (begin
                                (sv_spawn)
                                (cond
                                    ((>= sv_seconds 900) (set sv_spawn_clock 6))
                                    ((>= sv_seconds 600) (set sv_spawn_clock 8))
                                    ((>= sv_seconds 360) (set sv_spawn_clock 10))
                                    (true (set sv_spawn_clock 15))))))
                    (cond
                        ((and (>= (objects_distance_to_flag (players) sv_beacon_exit) 0) (<= (objects_distance_to_flag (players) sv_beacon_exit) 1.0))
                            (begin
                                (set sv_running false)
                                (set sv_finished true)
                                (cinematic_set_chud_objective sv_win)
                                (game_won)))
                        ((>= sv_seconds 1260) (sv_lose))))))))

(script startup sv_boot
    (sleep_until (> (list_count (players)) 0) 1)
    (if (= (list_count (players)) 1)
        (begin
            (hud_enable_training false)
            (camera_control true)
            (camera_set sv_overhead 0)
            (player_camera_control false)
            (object_set_facing (sv_player) sv_heading)
            (chud_show_weapon_stats false)
            (chud_show_grenades false)
            (player_enable_input true)
            (chud_show_crosshair false)
            (unit_add_equipment (sv_player) sv_start true false)
            (cinematic_set_chud_objective sv_intro)
            (set sv_running true)
            (sv_spawn))
        (begin
            (cinematic_set_chud_objective sv_solo)
            (set sv_finished true))))

(script continuous sv_clock
    (sleep 30)
    (sv_step))

