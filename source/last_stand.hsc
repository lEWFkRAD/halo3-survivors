; LAST STAND - native Halo 3 survival mod source.
; Scenario contract is scenario-contract.json. Single-player only.
; Tick assumes Halo 3's default 30 simulation ticks/sec; verify in tag_test.
(global boolean sv_running false)
(global boolean sv_finished false)
(global boolean sv_pad_latched false)
(global long sv_seconds 0)
(global long sv_xp 0)
(global long sv_threshold 100)
(global short sv_level 1)
(global short sv_tokens 0)
(global short sv_needler_rank 0)
(global short sv_aegis_rank 0)
(global short sv_vitality_rank 0)
(global short sv_spawn_clock 0)
(global short sv_shield_clock 0)
(global short sv_cap 36)
(global short sv_now 0)
(global short sv_total 0)
(global object sv_target none)
(global object sv_candidate none)
(global real sv_nearest 12)
(global real sv_distance -1)
(global long sv_shots 0)
(global object_list sv_actor_list (players))
(global object_list sv_players (players))
(global object_list sv_view_players (players))
(global short sv_view_index -1)
(global short sv_view_current -1)
(global real sv_view_distance 0)
(global real sv_view_nearest 100000)
(global short sv_grunts_a_prev 0)
(global short sv_grunts_b_prev 0)
(global short sv_grunts_c_prev 0)
(global short sv_grunts_d_prev 0)
(global short sv_jackals_prev 0)
(global short sv_brutes_prev 0)
(global short sv_flood_prev 0)
(global short sv_hunters_prev 0)

(script static unit sv_player (unit (list_get (players) 0)))
(script static void sv_observe
    (set sv_now (ai_living_count sv_grunts_a))
    (if (< sv_now sv_grunts_a_prev)
        (set sv_xp (+ sv_xp (* (- sv_grunts_a_prev sv_now) 10))))
    (set sv_grunts_a_prev sv_now)
    (set sv_now (ai_living_count sv_grunts_b))
    (if (< sv_now sv_grunts_b_prev)
        (set sv_xp (+ sv_xp (* (- sv_grunts_b_prev sv_now) 10))))
    (set sv_grunts_b_prev sv_now)
    (set sv_now (ai_living_count sv_grunts_c))
    (if (< sv_now sv_grunts_c_prev)
        (set sv_xp (+ sv_xp (* (- sv_grunts_c_prev sv_now) 10))))
    (set sv_grunts_c_prev sv_now)
    (set sv_now (ai_living_count sv_grunts_d))
    (if (< sv_now sv_grunts_d_prev)
        (set sv_xp (+ sv_xp (* (- sv_grunts_d_prev sv_now) 10))))
    (set sv_grunts_d_prev sv_now)
    (set sv_now (ai_living_count sv_jackals))
    (if (< sv_now sv_jackals_prev)
        (set sv_xp (+ sv_xp (* (- sv_jackals_prev sv_now) 20))))
    (set sv_jackals_prev sv_now)
    (set sv_now (ai_living_count sv_brutes))
    (if (< sv_now sv_brutes_prev)
        (set sv_xp (+ sv_xp (* (- sv_brutes_prev sv_now) 30))))
    (set sv_brutes_prev sv_now)
    (set sv_now (ai_living_count sv_flood))
    (if (< sv_now sv_flood_prev)
        (set sv_xp (+ sv_xp (* (- sv_flood_prev sv_now) 15))))
    (set sv_flood_prev sv_now)
    (set sv_now (ai_living_count sv_hunters))
    (if (< sv_now sv_hunters_prev)
        (set sv_xp (+ sv_xp (* (- sv_hunters_prev sv_now) 100))))
    (set sv_hunters_prev sv_now)
)
(script static void sv_autofire
