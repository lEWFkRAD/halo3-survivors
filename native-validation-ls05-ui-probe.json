  "observations": [
    {
      "id": "title_capacity",
      "result": "four_concurrent_titles_observed",
      "details": "Initial attempt was saturated by repeated 90-second wallet titles and is not capacity evidence. After disabling sv_running and allowing old titles to expire, calls sv_points_0 through 3 were accepted; calls 4 through 31 logged no free chapter title slots. Tags still contained 128 definitions. First grid positions overlapped due native bounds/clamping."
    },
    {
      "id": "training_and_objective",
      "result": "observed_together",
      "details": "Stock training_shieldsrecharging and sv_node_0 objective appeared together with the repair loop inactive."
    },
    {
      "id": "scenario_string_lookup",
      "result": "negative",
      "details": "hud_set_training_text sv_tree_0 rendered #sv_tree_0#; scenario title strings were not found through this channel."
    },
    {
      "id": "private_hud_route",
      "result": "observed_with_override_flag",
      "details": "Representation + private biped/CHUD alone retained stock panel. Setting cleaned binding flag override globals (bit 4) activated the visibly enlarged private training panel. All three CHUD global skin text references pointed to the appended private messages table."
    },
    {
      "id": "long_training_text",
      "result": "clipped",
      "details": "339- and 364-character graph samples ended after roughly four visible lines; both END markers were absent. No exact character or glyph cap established."
    },
    {
      "id": "short_multiline",
      "result": "all_twelve_lines_observed",
      "details": "94-character CRLF sample LINE01 through LINE12 rendered completely alongside the objective. This rules out a universal four-line limit in this configuration."
    },
    {
      "id": "compact_sample",
      "result": "complete_static_sample",
      "details": "75-character SEEDED sample showed MAX, OWN, BUY, LOCK and END. It is a display fixture, not proof of live game ranks or a purchase."
    },
    {
      "id": "ruler",
      "result": "inconclusive_for_exact_limit",
      "details": "320-character unwrapped ruler began off-screen and clipped. Layout and glyph/character limits remain unresolved."
    },
    {
      "id": "visibility",
      "result": "training_disable_required",
      "details": "hud_show_training_text false allowed the stock Use mouse to turn prompt; hud_enable_training false hid the panel."
    }
  ],
